# Application mode; production requires HTTPS and an explicit APP_SECRET.
APP_ENV=development
# HTTP port; Render supplies PORT automatically.
PORT=8000
# Flask session signing secret; generate a random value before deployment.
APP_SECRET=replace-this-with-a-random-secret
# SQLAlchemy database URL; SQLite locally or the Render PostgreSQL connection string.
DATABASE_URL=sqlite:///wedding_guest_manager.db
# Public HTTPS origin for login pages and password reset links in production.
CLIENT_URL=http://127.0.0.1:8000
# Local fallback for the public site URL; CLIENT_URL takes precedence when set.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Set true when the site is served over HTTPS.
COOKIE_SECURE=false
# Use shared Redis storage for request limits when running multiple instances.
RATELIMIT_STORAGE_URI=memory://
# SMTP server host for password reset email delivery.
SMTP_HOST=
# SMTP server port, commonly 587 for STARTTLS or 465 for implicit TLS.
SMTP_PORT=587
# SMTP account username.
SMTP_USERNAME=
# SMTP account password.
SMTP_PASSWORD=
# Verified sender email address.
SMTP_FROM_EMAIL=
# Enable STARTTLS for the SMTP connection.
SMTP_USE_TLS=true
# Enable implicit TLS instead of STARTTLS.
SMTP_USE_SSL=false
